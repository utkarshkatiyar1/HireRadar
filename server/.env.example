MONGO_URI=mongodb://localhost:27017/hireradar
PORT=5000
JWT_SECRET=<long-random>

# Redis (BullMQ queue backend — pipeline/inspection/apply queues)
REDIS_URL=redis://localhost:6379
PIPELINE_CONCURRENCY=3
APPLY_CONCURRENCY=1
INSPECTION_CONCURRENCY=2

# Apply-adapter safety — dry-run always wins over any per-ATS allowAutoSubmit
# config in PipelineConfig; never remove this default without explicit intent.
APPLY_DRY_RUN=true

# Local-only: disambiguates each worker's health-check port (Render free
# tier requires a "web" service to answer HTTP; workers use a trivial
# health endpoint purely to satisfy that — see src/workers/healthServer.js).
# Not needed on Render — each worker service gets its own auto-injected PORT.
PIPELINE_WORKER_PORT=10001
APPLY_WORKER_PORT=10002

# Screenshot signed-URL secret (Milestone 6 — audit trail image access)
SCREENSHOT_SIGNING_SECRET=<long-random>

# LLM provider — provider-neutral by design (server/src/llm/). Gemini is the
# initial/only provider, chosen to stay within its free tier during personal
# use and MVP development ($0 LLM bill target).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL_FAST=gemini-flash-lite-latest
LLM_MODEL_QUALITY=gemini-flash-latest
LLM_DAILY_REQUEST_LIMIT=100
LLM_MONTHLY_BUDGET_USD=0

# Answer generation only starts on an explicit user action
# (POST /applications/:id/prepare) — never automatically for every
# recommended job, to keep LLM spend proportional to actual intent to apply.
PREPARE_APPLICATIONS_AUTOMATICALLY=false
